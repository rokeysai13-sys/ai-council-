# ── kirannn Environment Variables Template ─────────────────────────────────────

# Bot Integration Tokens (Optional - bots will be skipped if not configured)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_personal_chat_id_here
DISCORD_TOKEN=your_discord_bot_token_here

# Default Admin User Credentials (created if database is empty on startup)
# If DEFAULT_PASSWORD is left blank/missing, a secure random password will be
# generated and logged to the server console on startup.
DEFAULT_USER=kiran
DEFAULT_PASSWORD=

# Ollama Model Orchestration Config
OLLAMA_URL=http://localhost:11434
MODEL_PRIMARY=llama3
MODEL_CODER=deepseek-coder:6.7b
MODEL_REASON=mistral
MODEL_ANALYSIS=qwen2.5:7b

# OpenAI API Key (Optional)
OPENAI_API_KEY=
